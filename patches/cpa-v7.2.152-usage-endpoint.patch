@@ -0,0 +1,59 @@
+package pluginhost
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/logging"
+	coreusage "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/usage"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+)
+
+func TestUsageAdapterPreservesEndpointAndStream(t *testing.T) {
+	for _, tc := range []struct {
+		name, endpoint, want string
+		stream, canceled     bool
+	}{
+		{"responses", "POST /v1/responses", "/v1/responses", true, false},
+		{"chat", "POST /v1/chat/completions", "/v1/chat/completions", false, false},
+		{"canceled", "POST /v1/messages", "/v1/messages", true, true},
+		{"path_only", "/v1/responses", "/v1/responses", false, false},
+		{"unknown", "", "", false, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var payload []byte
+			plugin := usagePluginFunc(func(ctx context.Context, record pluginapi.UsageRecord) {
+				if ctx.Err() != nil {
+					t.Fatalf("usage context canceled: %v", ctx.Err())
+				}
+				var err error
+				payload, err = json.Marshal(record)
+				if err != nil {
+					t.Fatal(err)
+				}
+			})
+			host := newHostWithRecords(capabilityRecord{
+				id:     "usage-endpoint",
+				plugin: pluginapi.Plugin{Capabilities: pluginapi.Capabilities{UsagePlugin: plugin}},
+			})
+			adapter := &usageAdapter{host: host, pluginID: "usage-endpoint"}
+			ctx, cancel := context.WithCancel(logging.WithEndpoint(context.Background(), tc.endpoint))
+			defer cancel()
+			if tc.canceled {
+				cancel()
+			}
+			adapter.HandleUsage(ctx, coreusage.Record{Provider: "codex", Model: "test", Stream: tc.stream})
+			var got struct {
+				Endpoint string
+				Stream   bool
+			}
+			if err := json.Unmarshal(payload, &got); err != nil {
+				t.Fatal(err)
+			}
+			if got.Endpoint != tc.want || got.Stream != tc.stream {
+				t.Fatalf("wire endpoint/stream = %q/%v, want %q/%v", got.Endpoint, got.Stream, tc.want, tc.stream)
+			}
+		})
+	}
+}
